<launch>
  <!-- slam-replay から起動される。設定は gen_config.py が $WORK に生成したもの -->
  <arg name="config_dir" />
  <arg name="rviz" default="false" />
  <!-- bag に <image_topic>/compressed しか無い場合は raw に展開して渡す (FAST-LIVO2 は raw Image のみ購読) -->
  <arg name="image_topic" default="/image_raw" />
  <arg name="image_compressed" default="false" />

  <rosparam command="load" file="$(arg config_dir)/fast_livo2.yaml" />

  <node pkg="fast_livo" type="fastlivo_mapping" name="laserMapping" output="screen">
    <rosparam file="$(arg config_dir)/camera.yaml" />
  </node>

  <node if="$(arg image_compressed)" pkg="image_transport" type="republish" name="image_republish"
        args="compressed in:=$(arg image_topic) raw out:=$(arg image_topic)" output="screen" respawn="true" />

  <group if="$(arg rviz)">
    <node launch-prefix="nice" pkg="rviz" type="rviz" name="rviz" args="-d $(find fast_livo)/rviz_cfg/fast_livo2.rviz" />
  </group>
</launch>
